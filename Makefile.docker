BUILD_TARGET ?= local
BUILD_DOCKERFILE ?= Dockerfile
DOCKER_REGISTRY ?= docker.io
# SERVICE is defined in Makefile *after* this file is included, so this stays a
# recursive assignment and resolves at use time.
IMAGE ?= bborbe/$(SERVICE)

ifeq ($(VERSION),)
	VERSION := $(shell git describe --tags `git rev-list --tags --max-count=1`)
endif

# buca chains build, upload, clean and apply — all four are local-only, and a
# parse-time error is the only refusal `make -n` can observe.
ifneq ($(BUILD_TARGET),local)
ifneq ($(filter buca,$(MAKECMDGOALS)),)
$(error BUILD_TARGET=$(BUILD_TARGET): buca is local-only. Use `make build BUILD_TARGET=$(BUILD_TARGET) REF=<sha> VERSION=<tag>` for a cluster build)
endif
endif

ifeq ($(BUILD_TARGET),local)
BUILD_PREREQS := check-go-mod
else
BUILD_PREREQS := check-cluster-version
endif

.PHONY: build
build: $(BUILD_PREREQS)
ifeq ($(BUILD_TARGET),local)
	@if [ -z "$(VERSION)" ]; then echo "ERROR: no VERSION set and no git tag found — set VERSION=vX.Y.Z or create a tag" >&2; exit 1; fi
	DOCKER_BUILDKIT=1 \
	docker build \
	--pull \
	--no-cache \
	--rm=true \
	--platform=linux/amd64 \
	--build-arg DOCKER_REGISTRY=$(DOCKER_REGISTRY) \
	--build-arg BUILD_GIT_COMMIT=$$(git rev-parse --short HEAD) \
	--build-arg BUILD_DATE=$$(date -u +%Y-%m-%dT%H:%M:%SZ) \
	-t $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION) \
	-f Dockerfile .
else
	@echo "$(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)"
	BUILD_TARGET="$(BUILD_TARGET)" \
	REPO_URL="https://github.com/bborbe/notification-discord.git" \
	REF="$(REF)" \
	TAG="$(VERSION)" \
	DOCKERFILE="$(BUILD_DOCKERFILE)" \
	IMAGE="$(DOCKER_REGISTRY)/$(IMAGE)" \
	PUSH="true" \
	PUSH_SECRET="buildkit-push" \
	DOCKER_REGISTRY="$(DOCKER_REGISTRY)" \
	NAMESPACE="build" \
	TIMEOUT="3600" \
	./hack/build-cluster.sh
endif

ifeq ($(BUILD_TARGET),local)
.PHONY: check-go-mod
check-go-mod:
	@if [ -f "go.mod" ]; then \
		echo "go.mod found, running go mod vendor..."; \
		go mod vendor; \
	else \
		echo "go.mod not found, skipping go mod vendor."; \
	fi
endif

.PHONY: check-cluster-version
check-cluster-version:
	@if [ "$(origin VERSION)" = "file" ]; then \
		echo "ERROR: BUILD_TARGET=$(BUILD_TARGET) requires an explicit VERSION=TAG; VERSION was not passed on the command line." >&2; \
		exit 1; \
	fi

ifeq ($(BUILD_TARGET),local)
.PHONY: upload
upload:
	docker push $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION)

.PHONY: clean
clean:
	docker rmi $(DOCKER_REGISTRY)/$(IMAGE):$(VERSION) || true
	docker image prune -f || true
	docker builder prune --all -f || true
	rm -rf vendor
else
.PHONY: upload
upload:
	@echo "BUILD_TARGET=$(BUILD_TARGET): upload skipped (the cluster Job already pushed the image)"

.PHONY: clean
clean:
	@echo "BUILD_TARGET=$(BUILD_TARGET): clean skipped (no local image)"
endif

# Publish-only: no k8s in this repo. Deployment lives in the maintainer Helm
# chart (mirror + keel-pattern). apply is a no-op placeholder.
.PHONY: apply
apply:
	@echo "skip apply — publish-only"

# Operator-run publish to Docker Hub (requires `docker login`). CI runs
# `make precommit`, never `buca`, so the unconditional push is safe.
.PHONY: buca
buca: build upload clean apply
